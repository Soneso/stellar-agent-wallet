{
  "test_kind": "sequence",
  "name": "unlisted_approval",
  "category": "extended_grammar",
  "description": "Under approval mode a listed recipient allows and an unlisted one requires approval with the fixed reason and the default one-day lifetime. The list holds one exact M address (ID 1): that exact address allows, another ID of the same base and the base G are unlisted.",
  "tool": {
    "name": "stellar_pay",
    "destructive_hint": true,
    "read_only_hint": false,
    "chain_id_required": true,
    "chain_id": "stellar:testnet"
  },
  "profile_name": "default",
  "steps": [
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF" },
      "expected": { "kind": "Allow" }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "RequireApproval",
        "approval_reason": "counterparty_allowlist: an unlisted recipient requires approval",
        "approval_ttl_secs": 86400
      }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "MAKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKAAAAAAAAAAAAGYAU" },
      "expected": { "kind": "Allow" }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "MAKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKAAAAAAAAAAAALJTU" },
      "expected": {
        "kind": "RequireApproval",
        "approval_reason": "counterparty_allowlist: an unlisted recipient requires approval",
        "approval_ttl_secs": 86400
      }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GAKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRL26G" },
      "expected": {
        "kind": "RequireApproval",
        "approval_reason": "counterparty_allowlist: an unlisted recipient requires approval",
        "approval_ttl_secs": 86400
      }
    }
  ]
}
