{
  "test_kind": "sequence",
  "name": "mainnet_approved_hard_cap_refused",
  "category": "extended_grammar",
  "description": "Recorded payments that required approval consume the total allocation. Later per-payment and total hard caps still deny. Actual approval authority is covered by the durable mint tests.",
  "tool": {
    "name": "stellar_pay",
    "destructive_hint": true,
    "read_only_hint": false,
    "chain_id_required": true,
    "chain_id": "stellar:mainnet"
  },
  "profile_name": "default",
  "steps": [
    {
      "args": { "amount_stroops": "101", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "record": true,
      "expected": {
        "kind": "RequireApproval",
        "approval_reason": "counterparty_allowlist: an unlisted recipient requires approval",
        "approval_ttl_secs": 86400
      }
    },
    {
      "args": { "amount_stroops": "1001", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "Deny",
        "wire_code": "policy.deny.per_tx_cap_exceeded",
        "reason": {
          "PerTxCapExceeded": {
            "asset": "native",
            "max_stroops": "1000",
            "attempted_stroops": "1001"
          }
        }
      }
    },
    {
      "args": { "amount_stroops": "249", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "record": true,
      "expected": {
        "kind": "RequireApproval",
        "approval_reason": "counterparty_allowlist: an unlisted recipient requires approval",
        "approval_ttl_secs": 86400
      }
    },
    {
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "Deny",
        "wire_code": "policy.deny.total_budget_exhausted",
        "reason": {
          "TotalBudgetExhausted": {
            "asset": "native",
            "max_stroops": "350",
            "remaining_stroops": "0"
          }
        }
      }
    }
  ]
}
