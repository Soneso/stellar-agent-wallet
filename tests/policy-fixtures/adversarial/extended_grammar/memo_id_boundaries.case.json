{
  "test_kind": "sequence",
  "name": "memo_id_boundaries",
  "category": "extended_grammar",
  "description": "ID bindings at 0 and at the unsigned 64-bit maximum match only that ID. A neighboring ID refuses, and a text memo spelling the ID refuses as a kind mismatch.",
  "tool": {
    "name": "stellar_pay",
    "destructive_hint": true,
    "read_only_hint": false,
    "chain_id_required": true,
    "chain_id": "stellar:testnet"
  },
  "profile_name": "default",
  "steps": [
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GAKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRL26G", "memo_kind": "id", "memo": null, "memo_id": "0" },
      "expected": { "kind": "Allow" }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GAKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRL26G", "memo_kind": "id", "memo": null, "memo_id": "1" },
      "expected": { "kind": "Deny", "deny_reason": "memo_binding_mismatch", "wire_code": "policy.deny.memo_binding_mismatch", "reason": { "MemoBindingMismatch": { "kind": "id" } } }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GAKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRKFIVCUKRL26G", "memo_kind": "text", "memo": "0" },
      "expected": { "kind": "Deny", "deny_reason": "memo_binding_mismatch", "wire_code": "policy.deny.memo_binding_mismatch", "reason": { "MemoBindingMismatch": { "kind": "id" } } }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GALBMFQWCYLBMFQWCYLBMFQWCYLBMFQWCYLBMFQWCYLBMFQWCYLBMKWB", "memo_kind": "id", "memo": null, "memo_id": "18446744073709551615" },
      "expected": { "kind": "Allow" }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GALBMFQWCYLBMFQWCYLBMFQWCYLBMFQWCYLBMFQWCYLBMFQWCYLBMKWB", "memo_kind": "id", "memo": null, "memo_id": "18446744073709551614" },
      "expected": { "kind": "Deny", "deny_reason": "memo_binding_mismatch", "wire_code": "policy.deny.memo_binding_mismatch", "reason": { "MemoBindingMismatch": { "kind": "id" } } }
    }
  ]
}
