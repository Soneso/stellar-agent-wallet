{
  "test_kind": "sequence",
  "name": "floor_missing_facts_refused",
  "category": "extended_grammar",
  "description": "A strict floor check refuses as account.unread without an account view, with a plain view that carries no observation, and with an observation that carries no reservation sum. The views are core test inputs; current CLI and MCP callers supply none of the floor facts.",
  "tool": {
    "name": "stellar_pay",
    "destructive_hint": true,
    "read_only_hint": false,
    "chain_id_required": true,
    "chain_id": "stellar:testnet"
  },
  "profile_name": "default",
  "steps": [
    {
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": { "kind": "Deny", "deny_reason": "account.unread", "wire_code": "account.unread", "reason": "AccountUnread" }
    },
    {
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "account": { "balance_stroops": 1000 },
      "expected": { "kind": "Deny", "deny_reason": "account.unread", "wire_code": "account.unread", "reason": "AccountUnread" }
    },
    {
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "account": { "balance_stroops": 1000, "observed_age_ms": 0 },
      "expected": { "kind": "Deny", "deny_reason": "account.unread", "wire_code": "account.unread", "reason": "AccountUnread" }
    }
  ]
}
