{
  "test_kind": "sequence",
  "name": "total_digest_change",
  "category": "extended_grammar",
  "description": "The total allocation belongs to the signed digest. The same body at sequence 2 (total_digest_change_resigned.toml) is a new epoch that starts at zero; returning to sequence 1 finds its usage unchanged.",
  "tool": {
    "name": "stellar_pay",
    "destructive_hint": true,
    "read_only_hint": false,
    "chain_id_required": true,
    "chain_id": "stellar:testnet"
  },
  "profile_name": "default",
  "steps": [
    {
      "args": { "amount_stroops": "1000", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "record": true,
      "expected": { "kind": "Allow" }
    },
    {
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "Deny",
        "wire_code": "policy.deny.total_budget_exhausted",
        "reason": { "TotalBudgetExhausted": { "asset": "native", "max_stroops": "1000", "remaining_stroops": "0" } }
      }
    },
    {
      "policy": "total_digest_change_resigned",
      "args": { "amount_stroops": "1000", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "record": true,
      "expected": { "kind": "Allow" }
    },
    {
      "policy": "total_digest_change_resigned",
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "Deny",
        "wire_code": "policy.deny.total_budget_exhausted",
        "reason": { "TotalBudgetExhausted": { "asset": "native", "max_stroops": "1000", "remaining_stroops": "0" } }
      }
    },
    {
      "args": { "amount_stroops": "1", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "Deny",
        "wire_code": "policy.deny.total_budget_exhausted",
        "reason": { "TotalBudgetExhausted": { "asset": "native", "max_stroops": "1000", "remaining_stroops": "0" } }
      }
    }
  ]
}
