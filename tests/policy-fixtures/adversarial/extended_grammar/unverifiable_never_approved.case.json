{
  "test_kind": "sequence",
  "name": "unverifiable_never_approved",
  "category": "extended_grammar",
  "description": "A payment without a destination is unverifiable, not unlisted: approval mode keeps the counterparty denial. A classifiable unlisted recipient still escalates.",
  "tool": {
    "name": "stellar_pay",
    "destructive_hint": true,
    "read_only_hint": false,
    "chain_id_required": true,
    "chain_id": "stellar:testnet"
  },
  "profile_name": "default",
  "steps": [
    {
      "args": { "amount_stroops": "10", "asset": "native" },
      "expected": {
        "kind": "Deny",
        "deny_reason": "counterparty_denied",
        "wire_code": "policy.deny.counterparty_denied",
        "reason": { "CounterpartyDenied": { "kind": "G_ACCOUNT", "value": "" } }
      }
    },
    {
      "args": { "amount_stroops": "10", "asset": "native", "destination": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN" },
      "expected": {
        "kind": "RequireApproval",
        "approval_reason": "counterparty_allowlist: an unlisted recipient requires approval",
        "approval_ttl_secs": 86400
      }
    }
  ]
}
